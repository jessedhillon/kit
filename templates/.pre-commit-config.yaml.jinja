default_language_version:
  python: python3.13

default_install_hook_types:
  - pre-commit
  - commit-msg

repos:
  - repo: https://github.com/jessedhillon/conventional-msg
    rev: "0.2.1"
    hooks:
    - id: conventional-msg
      stages: [commit-msg]

  - repo: local
    hooks:
    - id: nix-fmt
      name: nix fmt
      entry: scripts/hooks/nix-fmt-and-restage.sh
      language: system
      files: \.(nix|py|ya?ml|md|tsx?|jsx?|json|s?css|html)$
      exclude: ^\.state/claude/skills/
      pass_filenames: true
      stages: [pre-commit]

  - repo: local
    hooks:
    - id: claude-md-check
      name: claude-md-check
      entry: scripts/hooks/claude-md-check.sh
      language: system
      files: (CLAUDE\.md(\.j2)?$|AGENTS\.md(\.j2)?$|^docs\.vault/.*\.md$|^scripts/generate-claude-md\.py$)
      pass_filenames: false
      stages: [pre-commit]

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.9.2
    hooks:
      - id: ruff
        stages: [pre-commit]

  - repo: local
    hooks:
    - id: pyright
      name: pyright
      entry: scripts/hooks/pyright-check.sh
      language: system
      types: [python]
      stages: [pre-commit]

  {%- if web_apps %}
  - repo: local
    hooks:
    - id: tsc
      name: tsc
      entry: bash -c 'for dir in {{ module_name }}/web/*/frontend; do [ -f "$dir/tsconfig.json" ] && (cd "$dir" && npx tsc -b --noEmit) || true; done'
      language: system
      files: ^{{ module_name }}/web/.*/frontend/.*\.tsx?$
      pass_filenames: false
      stages: [pre-commit]

  - repo: https://github.com/pre-commit/mirrors-prettier
    rev: v3.1.0
    hooks:
      - id: prettier
        name: prettier
        types_or: [javascript, jsx, ts, tsx, css, scss, html, json]
        additional_dependencies:
          - prettier@3.5.0
          - prettier-plugin-tailwindcss

  - repo: local
    hooks:
      - id: eslint
        name: eslint
        entry: eslint
        language: node
        types_or: [javascript, jsx, ts, tsx]
        files: \.(js|jsx|ts|tsx|css|scss|html|json)$
        additional_dependencies:
          - eslint@9.20.1
          - "@typescript-eslint/parser@8.24.0"
          - "@typescript-eslint/eslint-plugin@8.24.0"
  {%- endif %}
