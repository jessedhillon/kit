{
  "hooks": {
    "PreToolUse": [
    {
        "matcher": "Bash",
        "hooks": [
            {
                "type": "command",
                "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tmux-reminder.sh"
            }
        ]
    }
]{% if include_session_journal %},
    "PreCompact": [
    {
        "hooks": [
            {
                "type": "command",
                "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/{{ module_name }}-cli\" script extract-session-journal"
            }
        ]
    }
]{% endif %}
  }
}
