[build-system]
requires = ["poetry-core>=1.0.0", "poetry-dynamic-versioning>=1.0.0,<2.0.0"]
build-backend = "poetry_dynamic_versioning.backend"

[project]
name = "{{ project_name }}"
description = "..."
dynamic = [ "version" ]
requires-python = ">=3.13,<4.0"
authors = [
    {name = "Jesse Dhillon", email = "jesse@dhillon.com" },
]
dependencies = [
    "alembic~=1.14.0",
    "ansible~=11.1.0",
    "click~=8.1.0",
    "colorlog~=6.9.0",
    "dependency-injector~=4.45.0",
    "fastapi~=0.115.0",
    "keyctl~=0.5.0",
    "psycopg[binary]~=3.2.0",
    "pydantic[email]~=2.10.0",
    "pydantic-settings~=2.7.0",
    "pygments~=2.18.0",
    "shortuuid~=1.0.13",
    "sql-formatter~=0.6.2",
    "setuptools~=75.8.0",
    "types-Pygments==2.19.0.20250107",
{% if include_llm_scaffold %}
    "uuid-utils>=0.12,<1",
{% else %}
    "uuid-utils~=0.10.0",
{% endif %}
    "uvicorn[standard]~=0.34.0",
    "xdg-base-dirs~=6.0.0",
{%- if include_llm_scaffold %}
    # LLM scaffold
    "langchain>=1.0,<2",
    "langchain-openai>=1.0,<2",
    "langchain-anthropic>=1.0,<2",
    "langgraph>=1.1,<2",
    "jinja2~=3.1.0",
{%- endif %}
{%- if include_session_journal %}
    "anthropic>=0.50,<1",
{%- endif %}
{%- if include_streaming %}
    # Streaming scaffold
    "redis~=5.2.0",
{%- endif %}
{%- if include_auth %}
    # Auth scaffold
    "bcrypt~=4.2.0",
    "pyjwt~=2.10.0",
{%- endif %}
{%- if include_fixtures %}
    # Fixtures scaffold
    "PyYAML~=6.0.0",
{%- endif %}
]

[project.optional-dependencies]
test = [
    "pytest~=8.3.0",
]
dev = [
    "jdbpp@git+ssh://git@github.com/jessedhillon/jdbpp.git@14ade861a42be37536cc2612d028a2ae2dc589c8",
    "isort~=6.0.0",
    "jinja2~=3.1.0",
    "pyright~=1.1.0",
    "pyyaml~=6.0.0",
    "rpdb@git+ssh://git@github.com/incognita-labs/rpdb.git@v0.2.1",
    "ruff~=0.11.0",
    "sql_formatter~=0.6.0",
]

[project.scripts]
{{ module_name }}-cli = "{{ module_name }}.cli.__main__:execute_command"
{% if web_apps -%}

# Web apps register as entry points so the CLI can discover them dynamically.
# Add new apps here and under [tool.poetry.plugins] to make them `web serve <name>` targets.
[project.entry-points."{{ module_name }}.web"]
{%- for app in web_apps %}
{{ app.module_name }} = "{{ module_name }}.web.{{ app.module_name }}:app"
{%- endfor %}
{%- endif %}

[tool.setuptools]
packages = [ "{{ module_name }}" ]

[tool.setuptools.dynamic]
version.attr = "{{ module_name }}.__version__"

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
addopts = "--strict-markers -svx --pdbcls=jdbpp:Pdb"
filterwarnings = [
  "ignore:.*type_params.*ForwardRef._evaluate.*:DeprecationWarning:pydantic\\.v1\\.typing"
]

[tool.pyright]
exclude = [
  "{{ module_name }}/typings/",
  "{{ module_name }}/core/container/vendor.py",
  "{{ module_name }}/lib/sheets.py",
  "scripts/render-agent-prompt.py",
  "**/node_modules/**",
  "**/.venv/**",
]
venvPath = "."
venv = ".venv"
typeCheckingMode = "strict"
stubPath = "{{ module_name }}/typings/"

reportUnusedImport = false  # let ruff catch this
reportUnusedVariable = false  # let ruff catch this

# WARN: these would nice to have, but require better typings for dependency-injector (or lots of silencing)
reportUnknownParameterType = true
reportUnknownArgumentType = true
reportUnknownLambdaType = true
reportUnknownVariableType = true
reportUnknownMemberType = false
reportMissingTypeStubs = false

[tool.ruff]
exclude = [
  ".venv",
  "{{ module_name }}/typings/"
]
line-length = 120
lint.select = [ "E", "F", "B", "T" ]
lint.extend-ignore = [
    "I",
    "B008"  # calling function in parameter list
]
preview = true
target-version = "py313"

[tool.ruff.lint.per-file-ignores]
"{{ module_name }}/model/id.py" = ["E302"]

[tool.black]
line-length = 120
target-version = ["py313"]
force-exclude = '{{ module_name }}/typings/*'
skip-string-normalization = true

[tool.isort]
line_length = 120
multi_line_output = 2  # HANGING_INDENT
skip_glob = [
    "{{ module_name }}/typings/**/*.pyi"
]

[tool.kit]
module-name = "{{ module_name }}"

[tool.kit.features]
tunnels = {{ include_tunnels | lower }}

[tool.kit.ports]
postgresql = {{ postgresql_port }}
process-compose = {{ process_compose_port }}
memcached = {{ memcached_port }}
rabbitmq = {{ rabbitmq_port }}

[tool.poetry]
name = "{{ project_name }}"
version = "0.0.0"  # placeholder, read from VERSION.txt by poetry-dynamic-versioning
packages = [{ include = "{{ module_name }}" }]

[tool.poetry-dynamic-versioning]
enable = true

[tool.poetry-dynamic-versioning.from-file]
source = "VERSION.txt"
